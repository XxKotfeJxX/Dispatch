DATABASE_URL=postgres://dispatch:dispatch@postgres:5432/dispatch?sslmode=disable
DISPATCH_VERSION=dev
API_ADDR=:8080
CONSOLE_AUTH_ENABLED=false
API_KEY=dispatch-local-development-key
WEB_ORIGIN=http://localhost:8090
WEB_PORT=8090
DISPATCH_DNS_PRIMARY=1.1.1.1
DISPATCH_DNS_SECONDARY=8.8.8.8
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

WORKER_ID=dispatch-worker-1
WORKER_CONCURRENCY=4
JOB_POLL_INTERVAL=500ms
JOB_LOCK_TIMEOUT=2m
PROVIDER_TIMEOUT=10s

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=12s
AI_MIN_CONFIDENCE=0.75
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=512
AI_SUMMARY_MAX_CHARS=180
AI_THINKING_LEVEL=minimal
AI_PROMPT_VERSION=dispatch-analysis-v3

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dispatch@localhost
SMTP_TLS=false
MAILPIT_PUBLIC_URL=http://localhost:8025
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_FROM=dispatch@localhost
MAILPIT_MAX_MESSAGES=0
MAILPIT_MAX_AGE=
MAILPIT_AUTH_FILE=./.local/inbox-auth
MAILPIT_ALLOW_REGISTRATION=true

# Optional outbound delivery channel; unrelated to the inbound account connector.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

WEBHOOK_ENABLED=true
WEBHOOK_DEFAULT_URL=
WEBHOOK_ALLOW_PRIVATE=false

INGRESS_ENCRYPTION_KEY=

CONNECTOR_PUBLIC_URL=http://localhost:8090
CONNECTOR_ENCRYPTION_KEY=
# Deployment-owned Telegram application for inbound personal-account sessions.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
# Development only: stable webhook proxy URL created at https://smee.io
GITHUB_SMEE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google service synchronization interval. Minimum: 5s.
GOOGLE_POLL_INTERVAL=30s
# YouTube subscription-feed polling interval. Minimum: 1m.
YOUTUBE_POLL_INTERVAL=10m

DISCORD_BOT_TOKEN=
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_ACKNOWLEDGE=true

DEMO_SEED=true
