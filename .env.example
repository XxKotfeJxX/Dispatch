DATABASE_URL=postgres://dispatch:dispatch@postgres:5432/dispatch?sslmode=disable
DISPATCH_VERSION=dev
API_ADDR=:8080
CONSOLE_AUTH_ENABLED=false
API_KEY=dispatch-local-development-key
WEB_ORIGIN=http://localhost:8090
WEB_PORT=8090
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

WORKER_ID=dispatch-worker-1
WORKER_CONCURRENCY=4
JOB_POLL_INTERVAL=500ms
JOB_LOCK_TIMEOUT=2m
PROVIDER_TIMEOUT=10s

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=5s
AI_MIN_CONFIDENCE=0.75
AI_MAX_OUTPUT_TOKENS=512
AI_PROMPT_VERSION=dispatch-routing-v1

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dispatch@localhost
SMTP_TLS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

WEBHOOK_ENABLED=true
WEBHOOK_DEFAULT_URL=
WEBHOOK_ALLOW_PRIVATE=false

INGRESS_ENCRYPTION_KEY=

CONNECTOR_PUBLIC_URL=http://localhost:8090
CONNECTOR_ENCRYPTION_KEY=
GITHUB_APP_SLUG=
DISCORD_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

DISCORD_BOT_TOKEN=
DISCORD_INGRESS_URL=http://api:8080/ingest/v1/discord
DISCORD_INGRESS_SECRET=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_ACKNOWLEDGE=true

DEMO_SEED=true
